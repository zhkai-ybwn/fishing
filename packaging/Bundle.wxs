<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="fishing"
          Manufacturer="fishing contributors"
          Version="$(Version)"
          UpgradeCode="{460EC1B8-E97B-4F5B-B232-7A4B6218D6BA}"
          AboutUrl="https://github.com/zhkai-ybwn/fishing"
          IconSourceFile="$(IconPath)"
          Compressed="yes" DisableModify="yes">
    <Variable Name="DesktopShortcut" Type="numeric" Value="1" Persisted="yes" bal:Overridable="yes" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
                                              LogoFile="$(LogoPath)" ThemeFile="$(ThemePath)"
                                              LocalizationFile="$(LocalizationPath)" SuppressOptionsUI="yes" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(MsiPath)">
        <MsiProperty Name="FISHINGDESKTOPSHORTCUT" Value="[DesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
