<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="fishing"
           Manufacturer="fishing contributors"
           Version="$(Version)"
           UpgradeCode="{0E2F9A9B-7B1C-4BCE-A989-FBCE8249FEA1}"
           Scope="perUser" Language="2052" Codepage="936">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade IgnoreLanguage="yes" DowngradeErrorMessage="已安装较新版本的 fishing。" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/zhkai-ybwn/fishing" />
    <Property Id="ARPPRODUCTICON" Value="fishing.ico" />
    <Icon Id="fishing.ico" SourceFile="$(IconPath)" />
    <Property Id="FISHINGDESKTOPSHORTCUT" Value="1" Secure="yes" />
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(BrandDirectory)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BrandDirectory)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(BrandDirectory)\dialog.bmp" />

    <!-- Keep the install directory and component keys stable for upgrades. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BossSensor">
          <Component Id="BossSensorFiles" Guid="{DF96F906-6AC4-4DB8-9523-BCD56F775265}">
            <File Source="$(PayloadDirectory)\fishing.exe" />
            <File Source="$(PayloadDirectory)\fishing-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\onnxruntime.dll" />
            <File Source="$(PayloadDirectory)\onnxruntime_providers_shared.dll" />
            <File Source="$(PayloadDirectory)\ONNX-Runtime-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\ONNX-Runtime-ThirdPartyNotices.txt" />
            <File Source="$(PayloadDirectory)\msvcp140.dll" />
            <File Source="$(PayloadDirectory)\msvcp140_1.dll" />
            <File Source="$(PayloadDirectory)\vcruntime140.dll" />
            <File Source="$(PayloadDirectory)\vcruntime140_1.dll" />
            <File Source="$(PayloadDirectory)\YuNet-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\SFace-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\Noto-Sans-SC-OFL.txt" />
            <File Source="$(PayloadDirectory)\Rust-Dependency-Licenses.txt" />
            <?if $(IncludeNotices) = yes ?>
              <File Source="$(PayloadDirectory)\THIRD_PARTY_NOTICES.md" />
            <?endif?>
            <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
            <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\BossSensor\Installer"
                           Name="Version" Type="string" Value="$(Version)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="BossSensorShortcut" Guid="{FBF053DB-B454-42EC-8F71-53734850129B}">
        <!-- The non-advertised shortcut inherits the icon embedded in fishing.exe. -->
        <Shortcut Id="StartBossSensor" Name="fishing"
                  Target="[INSTALLFOLDER]fishing.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\BossSensor\Installer"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="FishingDesktopShortcut" Guid="{CC9F4357-7330-41B2-A6A8-B6F51471F126}">
        <Shortcut Id="DesktopFishing" Name="fishing"
                  Target="[INSTALLFOLDER]fishing.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\BossSensor\Installer"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="BossSensorApp" Title="fishing" AllowAbsent="no" AllowAdvertise="no">
      <ComponentRef Id="BossSensorShortcut" />
      <ComponentRef Id="BossSensorFiles" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="桌面快捷方式"
             Description="在桌面添加 fishing 快捷方式" Level="1" AllowAdvertise="no">
      <Level Value="0" Condition="FISHINGDESKTOPSHORTCUT = 0" />
      <ComponentRef Id="FishingDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
