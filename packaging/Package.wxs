<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BossSensor"
           Manufacturer="BossSensor contributors"
           Version="$(Version)"
           UpgradeCode="{0E2F9A9B-7B1C-4BCE-A989-FBCE8249FEA1}"
           Scope="perUser">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of BossSensor is already installed." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/zhkai-ybwn/fishing" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BossSensor">
          <Component Id="BossSensorFiles" Guid="{DF96F906-6AC4-4DB8-9523-BCD56F775265}">
            <File Source="$(PayloadDirectory)\BossSensor.exe" />
            <File Source="$(PayloadDirectory)\BossSensor-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\onnxruntime.dll" />
            <File Source="$(PayloadDirectory)\onnxruntime_providers_shared.dll" />
            <File Source="$(PayloadDirectory)\ONNX-Runtime-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\ONNX-Runtime-ThirdPartyNotices.txt" />
            <File Source="$(PayloadDirectory)\msvcp140.dll" />
            <File Source="$(PayloadDirectory)\msvcp140_1.dll" />
            <File Source="$(PayloadDirectory)\vcruntime140.dll" />
            <File Source="$(PayloadDirectory)\vcruntime140_1.dll" />
            <File Source="$(PayloadDirectory)\YuNet-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\SFace-LICENSE.txt" />
            <File Source="$(PayloadDirectory)\Noto-Sans-SC-OFL.txt" />
            <File Source="$(PayloadDirectory)\Rust-Dependency-Licenses.txt" />
            <?if $(IncludeNotices) = yes ?>
              <File Source="$(PayloadDirectory)\THIRD_PARTY_NOTICES.md" />
            <?endif?>
            <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
            <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\BossSensor\Installer"
                           Name="Version" Type="string" Value="$(Version)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="BossSensorShortcut" Guid="{FBF053DB-B454-42EC-8F71-53734850129B}">
        <Shortcut Id="StartBossSensor" Name="BossSensor"
                  Target="[INSTALLFOLDER]BossSensor.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\BossSensor\Installer"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="BossSensorApp" Title="BossSensor">
      <ComponentRef Id="BossSensorShortcut" />
      <ComponentRef Id="BossSensorFiles" />
    </Feature>
  </Package>
</Wix>
